{
  "name": "@bixbd/utils-mcp",
  "version": "0.0.0",
  "description": "Connect utility portals to AI agents through MCP. Works with any MCP app via npx; credentials stay on your machine.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "utilities",
    "portals",
    "stdio"
  ],
  "license": "MIT",
  "author": "BIXBD (https://github.com/bixbd)",
  "homepage": "https://github.com/bixbd/utils-mcp#readme",
  "bugs": {
    "url": "https://github.com/bixbd/utils-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bixbd/utils-mcp.git",
    "directory": "packages/server"
  },
  "type": "module",
  "bin": {
    "utils-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "node dist/cli.js",
    "prepack": "bun run build",
    "pack:mcpb": "bun scripts/pack-mcpb.ts"
  },
  "devDependencies": {
    "@bixbd/utils-mcp-connector-example": "workspace:*",
    "@bixbd/utils-mcp-connector-desco": "workspace:*",
    "@bixbd/utils-mcp-connector-rapidpass": "workspace:*",
    "@bixbd/utils-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@bixbd/utils-mcp-connector-nesco": "workspace:*"
  }
}
