{
  "name": "@bixbd/utils-mcp",
  "version": "0.0.0",
  "description": "Connect utility portals to AI agents through MCP",
  "type": "module",
  "bin": {
    "utils-mcp": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "echo \"server: runs from source with Bun\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun src/cli.ts"
  },
  "dependencies": {
    "@bixbd/utils-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@bixbd/utils-mcp-connector-example": "workspace:*",
    "@bixbd/utils-mcp-connector-desco": "workspace:*"
  },
  "peerDependencies": {
    "@bixbd/utils-mcp-connector-example": "*",
    "@bixbd/utils-mcp-connector-desco": "*"
  },
  "peerDependenciesMeta": {
    "@bixbd/utils-mcp-connector-example": {
      "optional": true
    },
    "@bixbd/utils-mcp-connector-desco": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bixbd/utils-mcp.git",
    "directory": "packages/server"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
