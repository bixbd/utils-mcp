{
  "name": "utils-mcp-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "connectors/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "husky",
    "new:connector": "bun tools/scaffold/src/cli.ts new",
    "check:connectors": "bun tools/scaffold/src/cli.ts check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "oxlint --fix --deny-warnings"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "oxlint": "^1.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
